# Fill in the agents you use. An agent with no key stays visible in the hub but is never called.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
# Muse (Meta) through the Meta Model API (key from dev.meta.ai). Endpoint defaults to https://api.meta.ai/v1.
MUSE_API_KEY=
# MUSE_BASE_URL=https://api.meta.ai/v1

# Optional model overrides (defaults live in agents.json)
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_MODEL=
# XAI_MODEL=
# PERPLEXITY_MODEL=preset:fast     (or perplexity/sonar, preset:low … preset:xhigh)
# MUSE_MODEL=muse-spark-1.3

# When the playbook is unsure (close call, or a council could help): ask = show options, pick = go with the top one
HUB_WHEN_UNSURE=ask

# Web console
HUB_PORT=4747
HUB_HOST=127.0.0.1

# Telegram (optional): talk to the hub from your phone. Token from @BotFather; chat ids the bot may answer.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHATS=

# Composio (optional): 500+ apps for every agent. Key from app.composio.dev.
COMPOSIO_API_KEY=
# COMPOSIO_USER_ID=jonathan

# Browser automation: set to 0 to watch the hub's browser work instead of running it hidden.
# BROWSER_HEADLESS=1
