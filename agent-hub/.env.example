# Fill in the agents you use. An agent with no key stays visible in the hub but is never called.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
# Meta's Llama API (OpenAI-compatible). Point META_BASE_URL elsewhere if MetaMuse runs on a different endpoint.
META_API_KEY=
META_BASE_URL=https://api.llama.com/compat/v1
# Muse.ai is a video platform, not a chat model: the hub routes video work to it as a hand-off.
MUSEAI_API_KEY=

# Optional model overrides (defaults live in agents.json)
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_MODEL=
# XAI_MODEL=
# PERPLEXITY_MODEL=
# META_MODEL=

# Web console
HUB_PORT=4747
HUB_HOST=127.0.0.1
