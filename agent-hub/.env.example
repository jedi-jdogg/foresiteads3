# Fill in the agents you use. An agent with no key stays visible in the hub but is never called.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
# Muse (Meta) through the Meta Model API. Copy the key and the OpenAI-compatible endpoint
# (base URL) from Meta's developer console; Muse stays greyed out until both are set.
MUSE_API_KEY=
MUSE_BASE_URL=

# Optional model overrides (defaults live in agents.json)
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_MODEL=
# XAI_MODEL=
# PERPLEXITY_MODEL=
# MUSE_MODEL=muse-spark-1.3

# Web console
HUB_PORT=4747
HUB_HOST=127.0.0.1
